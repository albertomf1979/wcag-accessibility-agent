# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional — por defecto claude-sonnet-4-6)
WCAG_MODEL=claude-sonnet-4-6

# Directorio de outputs (opcional — por defecto ./outputs)
WCAG_OUTPUT_DIR=./outputs

# Cloudflare (solo si despliegas la interfaz web para equipos)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_PAGES_PROJECT=wcag-accessibility
